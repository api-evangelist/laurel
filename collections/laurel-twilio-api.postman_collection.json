          "name": "Get phone number details from Twilio",
          "request": {
            "name": "Get phone number details from Twilio",
            "description": {
              "content": "Retrieves phone number caller name information from Twilio API. Results are cached in the database. Use the force parameter to bypass cache and fetch fresh data.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "twilio",
                "phone-lookups"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "phoneNumber",
                  "value": "<string>",
                  "description": "(Required) The phone number to lookup (E.164 format, e.g., +1234567890)"
                },
                {
                  "disabled": false,
                  "key": "force",
                  "value": "false",
                  "description": "Force a fresh lookup from Twilio API even if cached data exists"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
