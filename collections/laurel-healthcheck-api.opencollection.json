{
  "opencollection": "1.0.0",
  "info": {
    "name": "Identity Service Ably HealthCheck API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "HealthCheck",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "HealthCheckController_getHeathCheck",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/healthcheck"
          }
        }
      ]
    }
  ],
  "bundled": true
}