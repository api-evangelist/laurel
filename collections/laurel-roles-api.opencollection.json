{
  "opencollection": "1.0.0",
  "info": {
    "name": "Identity Service Ably Roles API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Roles",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all roles",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/roles"
          },
          "docs": "List all roles"
        },
        {
          "info": {
            "name": "Return a specific role by Id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/roles/:roleId",
            "params": [
              {
                "name": "roleId",
                "value": "",
                "type": "path",
                "description": "role's id"
              }
            ]
          },
          "docs": "Return a specific role by Id"
        }
      ]
    }
  ],
  "bundled": true
}