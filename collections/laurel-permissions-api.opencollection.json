{
  "opencollection": "1.0.0",
  "info": {
    "name": "Identity Service Ably Permissions API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Permissions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all permissions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/permissions"
          },
          "docs": "List all permissions"
        },
        {
          "info": {
            "name": "Return a specific permission by Id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/permissions/:permissionId",
            "params": [
              {
                "name": "permissionId",
                "value": "",
                "type": "path",
                "description": "permission's id"
              }
            ]
          },
          "docs": "Return a specific permission by Id"
        }
      ]
    }
  ],
  "bundled": true
}